# Reference only: export these variables in your shell; no automatic .env loader.
FLOWTRAIL_DB=data/flowtrail.sqlite3
FLOWTRAIL_QUOTA_BYTES=10485760
FLOWTRAIL_MAX_OBJECT_BYTES=5242880
FLOWTRAIL_MAX_PENDING_RUNS=100
FLOWTRAIL_MAX_PARALLEL_RUNS=4
FLOWTRAIL_MAX_PARALLEL_NODES=8
FLOWTRAIL_PER_RUN_PARALLELISM=4
FLOWTRAIL_CONNECTORS_JSON={}
# Live inference is optional. Replace placeholders only in your local environment.
# FLOWTRAIL_MODEL_BASE_URL=https://your-model-service.example/v1
# FLOWTRAIL_MODEL_NAME=your-model-name
# FLOWTRAIL_MODEL_API_KEY=replace-with-your-key
